      {
        "id": "stage-1",
        "steps": [
          { "id": "s1", "effect": 2 }
        ]
      },
      { "id": "stage-2", "steps": [] },
      {
        "id": "stage-3",
        "steps": [
          { "id": "end-step", "effect": 1, "writes": { "finished": true } }
        ]
      }
    ]
  },
  "entries": [
    { "kind": "effect_completed", "stageId": "stage-1", "stepId": "s1", "output": { "iter": 1 } },
    { "kind": "routed", "stageId": "stage-1", "handle": "stage-2" },
    { "kind": "routed", "stageId": "stage-2", "handle": "stage-1" },
    { "kind": "effect_completed", "stageId": "stage-1", "stepId": "s1", "output": { "iter": 2 } },
    { "kind": "routed", "stageId": "stage-1", "handle": "stage-2" },
    { "kind": "routed", "stageId": "stage-2", "handle": "stage-3" }
  ],
  "expectedResumeAddress": { "stage": "" },
  "expectedState": { "iter": 1, "finished": true }
}
